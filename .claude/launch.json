{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "desktop-crm",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd /d desktop && npm run dev"
      ],
      "port": 5180
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd /d mobile && npx expo start --web"
      ],
      "port": 8081
    }
  ]
}
